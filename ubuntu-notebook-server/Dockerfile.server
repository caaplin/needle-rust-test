# Docker image for the Rust notebook server.
#
# The build stage compiles the server. The runtime stage runs the binary in a
# small Debian image. Mount the Docker socket into the server container so
# that the server can run commands in the notebook container:
#
#   docker run -v /var/run/docker.sock:/var/run/docker.sock ...
#
# The rustls TLS support (aws-lc-rs) needs a C/C++ compiler at build time.
# The rust:1-bookworm image includes one.

FROM rust:1-bookworm AS builder
WORKDIR /app
COPY Cargo.toml ./
COPY src ./src
COPY public ./public
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /app/target/release/ubuntu-notebook-server /usr/local/bin/ubuntu-notebook-server
COPY --from=builder /app/public ./public
ENV NOTEBOOK_PORT=8080
EXPOSE 8080
ENTRYPOINT ["ubuntu-notebook-server"]
